# Secrets only. Everything else — firm name, sending window, which Quo number a
# sequence uses, retry limits — is configured in the app under Settings, so it can
# be changed without a redeploy.
#
# On Railway, set these under your service's Variables tab. The in-app Help page
# has the same list with an explanation of each one.

# Set automatically by Railway when you attach a Postgres service.
DATABASE_URL=

# Quo (formerly OpenPhone). Workspace settings -> API; needs Owner or Admin.
QUO_API_KEY=
# Only if your account has not been migrated off OpenPhone:
# QUO_API_BASE=https://api.openphone.com/v1

# Given to you when you create the webhook in Quo.
QUO_WEBHOOK_SECRET=
# Alternative to the signing secret, passed as ?token= on the webhook URL:
# QUO_WEBHOOK_TOKEN=

# Slack app -> Basic Information -> App Credentials.
SLACK_SIGNING_SECRET=
# Slack app -> OAuth & Permissions, starts xoxb-.
SLACK_BOT_TOKEN=

# Sign in with Google for the dashboard. Google Cloud console -> APIs & Services
# -> Credentials -> OAuth client ID (Web application). The authorised redirect
# URI is PUBLIC_URL/auth/google/callback.
#
# Who is actually allowed in is the Access list inside the app, not this — a
# Google account that is not on the list is refused whatever domain it is on.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Workspace domain, e.g. yourfirm.com. Accounts outside it are refused
# before the access list is even consulted.
# GOOGLE_HOSTED_DOMAIN=

# Optional: Sign in with Slack as well.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_TEAM_ID=

# The simplest way to give yourself dashboard access: your work Google address.
# Applied at every boot, so you can sign in with Google straight away without
# ever needing the password below. Comma-separate for several people.
# It only ever grants — removing an address here revokes nothing, because that
# is done in the app where it is visible.
BOOTSTRAP_ADMIN_EMAIL=

# The other way in, if you would rather not use the one above. A break-glass for
# before anybody is on the access list. Use a long random value.
ADMIN_PASSWORD=

# Your deployed URL. Used to build the OAuth redirect URIs, and to decide
# whether session cookies are marked Secure (they are, whenever this is https).
PUBLIC_URL=

# Deliberately not setting NODE_ENV. On Railway it applies at build time as well
# as run time, and npm can read it as a signal to skip devDependencies — which is
# where vite lives, so the front-end build would fail.
