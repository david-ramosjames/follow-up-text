# Secrets only. Everything else — firm name, sending window, which Quo number a
# sequence uses, retry limits — is configured in the app under Settings, so it can
# be changed without a redeploy.
#
# On Railway, set these under your service's Variables tab. The in-app Help page
# has the same list with an explanation of each one.

# Set automatically by Railway when you attach a Postgres service.
DATABASE_URL=

# Quo (formerly OpenPhone). Workspace settings -> API; needs Owner or Admin.
QUO_API_KEY=
# Only if your account has not been migrated off OpenPhone:
# QUO_API_BASE=https://api.openphone.com/v1

# Given to you when you create the webhook in Quo.
QUO_WEBHOOK_SECRET=
# Alternative to the signing secret, passed as ?token= on the webhook URL:
# QUO_WEBHOOK_TOKEN=

# Slack app -> Basic Information -> App Credentials.
SLACK_SIGNING_SECRET=
# Slack app -> OAuth & Permissions, starts xoxb-.
SLACK_BOT_TOKEN=

# Sign in with Slack for the dashboard.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# SLACK_TEAM_ID=

# A way in before anybody is on the operator list. Use a long random value.
ADMIN_PASSWORD=

# Your deployed URL, used to build the Slack sign-in redirect.
PUBLIC_URL=

NODE_ENV=production
